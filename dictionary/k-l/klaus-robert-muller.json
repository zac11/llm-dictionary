  "explainer": {
    "lead": "Klaus-Robert Müller is a German computer scientist. His work spans machine learning, artificial intelligence, physics and informatics.",
    "contributions": [
      {
        "name": "He co-founded and is co-director of the Berlin Big Data Center (BBDC) of TU Berlin.",
        "detail": ""
      },
      {
        "name": "Müller has contributed extensively to several major interests of machine learning, including support vector machines (SVMs) and kernel methods, and artificial neural networks.",
        "detail": ""
      },
      {
        "name": "He pioneered applying new methods of pattern recognition in domains like brain–computer interfaces, using them for patients with Locked-in syndrome.",
        "detail": ""
      }
